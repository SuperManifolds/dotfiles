            padding wt_note_padding
            xalign 0.5
            ypos wt_note_ypos
            text wt_note substitute False italic True size wt_note_size color wt_note_color

screen wt_input(prompt, **kwargs):
    use wt_orig_input(prompt, **kwargs)

    $ wt_hint = wt_input_hint()
    if wt_hint:
