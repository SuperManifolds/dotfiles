    class wt_state(object):
        """Per-launch state outside the store, so it never ends up in save files."""
        failed = None
        crash_test = False  # set by `rpw.py verify --negative` to prove a runtime error only disables the patch

    def wt_fail(where, error):
        if wt_state.failed is None:
            wt_state.failed = "%s: %r" % (where, error)
            print("walkthrough: disabled after an error in %s" % wt_state.failed)

    def wt_guard(fallback):
        """Run the wrapped helper; on any error disable the patch and return fallback(*args) instead."""
        def wrap(fn):
            def run(*args, **kwargs):
                if wt_state.failed is None:
                    try:
                        return fn(*args, **kwargs)
                    except Exception as e:
                        wt_fail(fn.__name__, e)
                return fallback(*args, **kwargs)
            run.__name__ = fn.__name__
            return run
        return wrap

    def wt_key(filename, line):
        """The table key for a script location: path relative to game/, forward slashes, .rpy even when loaded from .rpyc."""
        fn = (filename or "").replace("\\", "/")
        if fn.startswith("game/"):
            fn = fn[5:]
        if fn.endswith(".rpyc"):
            fn = fn[:-1]
        return (fn, line)

    def wt_menu(location):
        """Return (menu node, hint entry) for a menu location, or (None, None) if unknown or outdated."""
        node = renpy.game.script.namemap.get(location)
        if not isinstance(node, renpy.ast.Menu):
            return None, None
        entry = wt_hints.get(wt_key(node.filename, node.linenumber))
        if entry is None or not node.items or node.items[0][0] != entry.get("sig"):
            return None, None
        return node, entry

    def wt_active():
        return wt_state.failed is None and persistent.wt_enabled and not _in_replay

    def wt_escape(s):
        return s.replace("[", "[[").replace("{", "{{")

    @wt_guard(lambda item: None)
    def wt_item_hint(item):
        """Return (kind, text) for a choice item, or None. Tuned screens call this directly."""
        if wt_state.crash_test:
            raise Exception("rpw crash test")
        action = getattr(item, "action", None)
        if not isinstance(action, renpy.ui.ChoiceReturn):
            return None
        node, entry = wt_menu(action.location)
        if entry is None:
            return None
        hint = entry["items"].get(action.value)
        if hint is None or node.items[action.value][0] != hint[0]:
            return None
        return hint[1], hint[2]

    wt_kind_style = {
        "good": ("wt_good_color", u"▲"),
        "bad": ("wt_bad_color", u"▼"),
        "info": ("wt_info_color", u"●"),
    }

    @wt_guard(lambda kind, text, enabled=True: u"")
    def wt_hint_line(kind, text, enabled=True):
        """The hint as one line of text tags: coloured glyph and text, escaped. Greyed out for disabled choices."""
        color_name, glyph = wt_kind_style.get(kind, wt_kind_style["info"])
        color = getattr(store, color_name) if enabled else wt_disabled_color
        # A no-break space before each " · " keeps the separator off the start of a wrapped line.
        text = wt_escape(text).replace(u" · ", u" · ")
        return u"{color=%s}{font=%s}%s{/font} %s{/color}" % (color, wt_glyph_font, glyph, text)

    def wt_caption(caption, kind, text, enabled=True, inline=False):
        sep = u"  " if inline else u"\n"
        return u"%s%s{size=%+d}%s{/size}" % (caption, sep, wt_hint_size_delta, wt_hint_line(kind, text, enabled))

    @wt_guard(lambda items: items)
    def wt_decorate(items):
        """Copies of the menu entries with the hint line appended to each hinted caption."""
        if not wt_active():
            return items
        inline = wt_inline_hints and len([i for i in items if getattr(i, "action", None) is not None]) >= wt_long_menu_from
        rv = []
        for item in items:
            hint = wt_item_hint(item)
            if hint is None:
                rv.append(item)
                continue
            # Greyed out by the menu condition (sensitive) or by an `enable=` item argument.
            enabled = (getattr(item.action, "sensitive", True) not in (False, None)
                       and (getattr(item, "kwargs", None) or {}).get("enable", True) not in (False, None, 0))
            caption = wt_caption(item[0], hint[0], hint[1], enabled, inline)
            new = type(item)((caption,) + tuple(item[1:]))
            new.__dict__.update(getattr(item, "__dict__", {}))
            new.caption = caption
            rv.append(new)
        return rv

    def wt_is_str(x):
        return isinstance(x, (type(""), type(u"")))

    try:
        import builtins as _wt_builtins
    except ImportError:
        import __builtin__ as _wt_builtins
    import operator as _wt_operator

    def wt_define_wrapper():
        # Python's own object: the store's `object` is Ren'Py's rollback class, which refuses __slots__ (8.2) and
        # would log the wrapper for rollback; the game's objects behind it already roll back.
        class WtHinted(_wt_builtins.object):
            """A list-screen item with a hinted caption. The caption attribute reads from here; every other read and
            every write goes to the game's own object, so the game's logic (visited flags, greyed-out items) is
            unchanged. It pickles as the game's object, so saves never contain this class."""
            __slots__ = ("_wt_item", "_wt_attr", "_wt_text")

            def __init__(self, item, attr, text):
                object.__setattr__(self, "_wt_item", item)
                object.__setattr__(self, "_wt_attr", attr)
                object.__setattr__(self, "_wt_text", text)

            def __getattr__(self, name):  # only for names that aren't slots or methods of this class
                if name == object.__getattribute__(self, "_wt_attr"):
                    return object.__getattribute__(self, "_wt_text")
                return getattr(object.__getattribute__(self, "_wt_item"), name)

            def __setattr__(self, name, value):
                setattr(object.__getattribute__(self, "_wt_item"), name, value)

            def __delattr__(self, name):
                delattr(object.__getattribute__(self, "_wt_item"), name)

            __class__ = property(lambda self: object.__getattribute__(self, "_wt_item").__class__)

            def __reduce__(self):
                # Rebuilds as the game's own object (operator.getitem([item], 0)), which exists without the patch.
                return (_wt_operator.getitem, ([object.__getattribute__(self, "_wt_item")], 0))

            def __eq__(self, other):
                return object.__getattribute__(self, "_wt_item") == wt_unwrap(other)

            def __ne__(self, other):
                return not self.__eq__(other)

            def __hash__(self):
                return hash(object.__getattribute__(self, "_wt_item"))

            def __repr__(self):
                return repr(object.__getattribute__(self, "_wt_item"))
        return WtHinted

    try:
        WtHinted = wt_define_wrapper()
    except Exception:
        WtHinted = None  # list screens then keep the game's captions, without hints

    def wt_unwrap(x):
        return object.__getattribute__(x, "_wt_item") if WtHinted is not None and type(x) is WtHinted else x

    wt_list_proxies = {}

    # One plain list per hinted list name, created during init and refilled in place: Ren'Py saves only store
    # variables rebound after init, and a plain list isn't tracked by rollback, so saves never hold the copies.
    for _wt_key in list(wt_hints):
        if _wt_key[0] == "@list":
            setattr(store, "wt_list__" + _wt_key[1], _wt_builtins.list())

    @wt_guard(lambda screen, args, kwargs: (list(args), dict(kwargs), None))
    def wt_list_args(screen, args, kwargs):
        """Arguments for the wrapped list screen: the list name swapped for the name of a list of the same items,
        hinted ones wrapped in WtHinted. Returns (args, kwargs, note)."""
        cfg = wt_list_screens[screen]
        args, kwargs = list(args), dict(kwargs)
        kw, pos, attr = cfg.get("kwarg"), cfg.get("arg", 0), cfg.get("text", "text")
        if kw and kw in kwargs:
            name = kwargs[kw]
        elif pos < len(args):
            name = args[pos]
        else:
            return args, kwargs, None
        if not wt_active() or not wt_is_str(name) or WtHinted is None:
            return args, kwargs, None
        if wt_state.crash_test:
            raise Exception("rpw crash test")
        entry = wt_hints.get(("@list", name))
        items = getattr(store, name, None)
        if entry is None or not items or getattr(items[0], attr, None) != entry["sig"]:
            return args, kwargs, None
        decorated = []
        for idx, item in enumerate(items):
            hint = entry["items"].get(idx)
            if hint is None or getattr(item, attr, None) != hint[0]:
                decorated.append(item)
                continue
            decorated.append(WtHinted(item, attr, wt_caption(hint[0], hint[1], hint[2])))
        proxy = "wt_list__" + name
        target = getattr(store, proxy, None)
        if type(target) is not _wt_builtins.list:
            return args, kwargs, None
        target[:] = decorated
        wt_list_proxies[proxy] = name
        if kw and kw in kwargs:
            kwargs[kw] = proxy
        else:
            args[pos] = proxy
        return args, kwargs, entry.get("note")

    def wt_unproxy(fn):
        """Wrap a game function so list names it receives are the real ones, not the decorated copies' names."""
        def wrapper(*args, **kwargs):
            args = [wt_list_proxies.get(a, a) if wt_is_str(a) else a for a in args]
            return fn(*args, **kwargs)
        return wrapper

    @wt_guard(lambda items, decorated: 0)
    def wt_shift(items, decorated):
        """Upward offset for a long menu: hinted items x hint line height x wt_long_menu_shift."""
        choices = [i for i in items if getattr(i, "action", None) is not None]
        if not wt_long_menu_shift or len(choices) < wt_long_menu_from:
            return 0
        hinted = len([1 for a, b in zip(items, decorated) if a is not b])
        size = getattr(gui, "choice_button_text_size", None) or getattr(gui, "text_size", 30)
        return -int(hinted * (size + wt_hint_size_delta) * 1.3 * wt_long_menu_shift)

    @wt_guard(lambda items: None)
    def wt_menu_note(items):
        if not wt_active():
            return None
        for item in items:
            action = getattr(item, "action", None)
            if isinstance(action, renpy.ui.ChoiceReturn):
                return (wt_menu(action.location)[1] or {}).get("note")
        return None

    @wt_guard(lambda: None)
    def wt_screen_note():
        """The note for the `call screen` statement being waited on, or None."""
        if not wt_active() or not wt_screen_notes:
            return None
        filename, line = renpy.get_filename_line()
        return wt_screen_notes.get(wt_key(filename, line), (None, None))[1]

    @wt_guard(lambda: None)
    def wt_input_hint():
        """Return the hint for the renpy.input prompt being shown, or None."""
        if not wt_active():
            return None
        filename, line = renpy.get_filename_line()
        return wt_input_hints.get(wt_key(filename, line), (None, None))[1]

    def wt_toggle():
        if wt_state.failed:
            renpy.notify("Walkthrough unavailable (it switched itself off after an error)")
            return
        persistent.wt_enabled = not persistent.wt_enabled
        renpy.notify("Walkthrough on" if persistent.wt_enabled else "Walkthrough off")
        renpy.restart_interaction()

    def wt_status_text():
        """`Walkthrough: on (W)`, naming the first toggle key; `off (error)` once the patch switched itself off."""
        key = wt_toggle_keys[0] if wt_toggle_keys else ""
        key = key.upper() if len(key) == 1 else key.replace("K_", "")
        state = "off (error)" if wt_state.failed else ("on" if persistent.wt_enabled else "off")
        return "Walkthrough: %s (%s)" % (state, key) if key else "Walkthrough: %s" % state

    try:
        config.keymap["wt_toggle"] = wt_toggle_keys
        config.underlay.append(renpy.Keymap(wt_toggle=Function(wt_toggle)))
        if wt_screen_notes:
            config.overlay_screens.append("wt_screen_note_overlay")
    except Exception as e:
        wt_fail("toggle key / overlay", e)

