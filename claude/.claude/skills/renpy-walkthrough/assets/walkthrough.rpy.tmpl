    def wt_check_list(key, entry):
        """Problems with a list entry; drops it (or its stale items) from the table."""
        items = getattr(store, key[1], None)
        attr = entry.get("attr", "text")
        if not isinstance(items, (list, tuple)) or not items or getattr(items[0], attr, None) != entry.get("sig"):
            del wt_hints[key]
            return ["%r: list missing or sig mismatch" % (key,)]
        out = []
        for idx, (caption, kind, text) in list(entry["items"].items()):
            if idx >= len(items) or getattr(items[idx], attr, None) != caption:
                out.append("%r[%d]: caption mismatch" % (key, idx))
                del entry["items"][idx]
        return out

    def wt_selfcheck():
        """Drop table entries that no longer match the game's script, and report the result."""
        menus = {}
        inputs = {}
        sources = {}
        for node in renpy.game.script.namemap.values():
            key = wt_key(node.filename, node.linenumber)
            if isinstance(node, renpy.ast.Menu):
                menus[key] = node
            elif isinstance(node, renpy.ast.Python):
                sources[key] = node.code.source
                if "renpy.input(" in node.code.source:
                    inputs[key] = node.code.source
            elif isinstance(node, renpy.ast.UserStatement):
                sources[key] = node.line
        total = len(wt_hints) + len(wt_input_hints) + len(wt_screen_notes)
        problems = []
        for key, (source, note) in list(wt_screen_notes.items()):
            if sources.get(key) != source:
                problems.append("%r: call screen statement differs" % (key,))
                del wt_screen_notes[key]
        for key, (source, text) in list(wt_input_hints.items()):
            if inputs.get(key) != source:
                problems.append("%r: renpy.input statement differs" % (key,))
                del wt_input_hints[key]
        for key, entry in list(wt_hints.items()):
            if key[0] == "@list":
                problems += wt_check_list(key, entry)
                continue
            node = menus.get(key)
            if node is None:
                problems.append("%r: no menu at that line" % (key,))
                del wt_hints[key]
                continue
            if not node.items or node.items[0][0] != entry.get("sig"):
                problems.append("%r: sig mismatch" % (key,))
                del wt_hints[key]
                continue
            for idx, (caption, kind, text) in list(entry["items"].items()):
                if idx >= len(node.items) or node.items[idx][0] != caption:
                    problems.append("%r[%d]: caption mismatch" % (key, idx))
                    del entry["items"][idx]
        for name, wrapped in wt_wrapped.items():
            if not wrapped:
                problems.append("no %r screen to wrap" % name)
        if wt_state.failed:
            problems.append("disabled: " + wt_state.failed)
        print("walkthrough: %d entries, %d mismatches; wrapped %r" % (total, len(problems), wt_wrapped))
        for p in problems:
            print("walkthrough: " + p)

    try:
        wt_selfcheck()
    except Exception as e:
        wt_hints.clear()
        wt_input_hints.clear()
        wt_fail("self-check", e)

screen wt_choice(*args, **kwargs):
    # The engine passes `items` by keyword and a menu's own arguments (menu ("phone"):) positionally; both are
    # forwarded unchanged apart from the decorated items.
    $ wt_items = wt_decorate(kwargs.get("items", ()))
    $ wt_dy = wt_shift(kwargs.get("items", ()), wt_items)
    $ wt_kwargs = dict(kwargs, items=wt_items)
    if wt_dy:
        fixed:
            at Transform(yoffset=wt_dy)
            use wt_orig_choice(*args, **wt_kwargs)
    else:
        use wt_orig_choice(*args, **wt_kwargs)
    use wt_overlay(wt_menu_note(kwargs.get("items", ())))

screen wt_missing(*args, **kwargs):
    # Stands in for a screen the game doesn't define, so wrappers that `use` it still prepare.
    null

screen wt_overlay(note):
    if note:
        frame:
            background wt_note_background
            padding wt_note_padding
            xalign 0.5
            ypos wt_note_ypos
            text note substitute False italic True size wt_note_size color wt_note_color

    if not _in_replay:
        # A button, so touch screens can toggle too; kept out of keyboard and gamepad navigation.
        button:
            style "wt_status_button"
            align wt_status_align
            action Function(wt_toggle)
            keyboard_focus False
            text wt_status_text() substitute False size wt_status_size color wt_status_color hover_color wt_status_hover_color outlines wt_status_outlines

style wt_status_button is default:
    background None
    padding (wt_px(8), wt_px(4))

screen wt_screen_note_overlay():
    zorder 900
    $ wt_note = wt_screen_note()
    if wt_note:
        frame:
