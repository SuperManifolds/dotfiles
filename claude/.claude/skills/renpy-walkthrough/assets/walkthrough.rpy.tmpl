    def wt_px(n):
        """Pixel sizes are for a 1080p game; scale them to this game's resolution, and up on phones."""
        return int(round(n * config.screen_height / 1080.0 * (wt_small_scale if renpy.variant("small") else 1.0)))

    wt_small_scale = 1.4  # phones ("small" variant) show the whole screen on a few inches

