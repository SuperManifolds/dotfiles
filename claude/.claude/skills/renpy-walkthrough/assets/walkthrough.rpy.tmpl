    import copy as _wt_copy  # aliased: a game may have its own `copy` in the store

    # Screen properties the stand-in takes from the original; older engines lack some of them.
    wt_screen_attrs = ("zorder", "modal", "tag", "layer", "sensitive", "roll_forward")

    def wt_alias(name):
        """Register the game's screen `name` (every variant) as wt_orig_<name>, or a placeholder if the game has
        none, so the wrappers' `use wt_orig_<name>` always resolves. Kept even if the take-over fails."""
        sd = renpy.display.screen
        alias = "wt_orig_" + name
        variants = sd.get_all_screen_variants(name) or [(None, sd.get_screen_variant("wt_missing"))]
        for variant, orig in variants:
            sd.screens[(alias, variant)] = orig
            sd.screens_by_name[alias][variant] = orig
        return variants

    def wt_take_over(name, wrapper, undo):
        """Point every variant of screen `name` at a copy of `wrapper` carrying the original's properties.
        Each change is recorded in `undo` so a failure can restore the game's screens."""
        sd = renpy.display.screen
        wrap = sd.get_screen_variant(wrapper)
        variants = sd.get_all_screen_variants(name)
        if wrap is None or not variants:
            return []
        for variant, orig in variants:
            stand_in = _wt_copy.copy(wrap)
            for attr in wt_screen_attrs:
                if hasattr(orig, attr):
                    setattr(stand_in, attr, getattr(orig, attr))
            for table, key in ((sd.screens, (name, variant)), (sd.screens_by_name[name], variant)):
                undo.append((table, key, table.get(key, wt_take_over)))
                table[key] = stand_in
        return [(v, o.location) for v, o in variants]

    def wt_install():
        """Take over the screens and wrap the unproxy functions; on any error undo everything and disable."""
        names = ["choice", "input"] + list(wt_list_screens)
        try:
            for name in names:
                wt_alias(name)
        except Exception as e:
            wt_fail("screen aliases", e)
            return {"disabled": True}
        undo = []
        wrapped = {}
        try:
            wrapped["choice"] = "tuned" if wt_tuned else wt_take_over("choice", "wt_choice", undo)
            for name, cfg in wt_list_screens.items():
                wrapped[name] = wt_take_over(name, "wt_list_" + name, undo)
                for fn in cfg.get("unproxy", []):
                    undo.append((store.__dict__, fn, getattr(store, fn)))
                    setattr(store, fn, wt_unproxy(getattr(store, fn)))
            if wt_input_hints:
                wrapped["input"] = wt_take_over("input", "wt_input", undo)
            # @RPW-CRASH-TEST-INIT@
        except Exception as e:
            for table, key, old in reversed(undo):
                if old is wt_take_over:
                    del table[key]
                else:
                    table[key] = old
            wt_fail("screen take-over", e)
            return {"disabled": True}
        return wrapped

    wt_wrapped = wt_install()

