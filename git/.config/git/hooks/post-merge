#!/bin/sh
# Generated by `git lfs install`, then extended to chain, the same way
# pre-commit does: core.hooksPath replaces repo-local hooks entirely, so
# without the tail below a repo's own post-merge would be silently skipped.
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-merge' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-merge "$@" || exit $?

repo_hook="$(git rev-parse --git-dir 2>/dev/null)/hooks/post-merge"
if [ -x "$repo_hook" ] && ! [ "$repo_hook" -ef "$0" ]; then
  exec "$repo_hook" "$@"
fi
exit 0
