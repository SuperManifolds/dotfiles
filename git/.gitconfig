# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = Alex Sørlie
	email = alex@sorlie.io
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	verbose = true
	gpgsign = true
[core]
	hooksPath = ~/.config/git/hooks
	# delta when available, plain less otherwise (keeps git working on
	# machines where delta isn't installed).
	pager = delta 2>/dev/null || less
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
	gpgsign = true
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	autoSetupRemote = true
	followTags = true
	default = simple
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
	missingCommitsCheck = error
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[format]
	signoff = true
[interactive]
	# Colorize `git add -p` via delta; fall back to plain when absent.
	diffFilter = delta --color-only 2>/dev/null || cat
[delta]
	navigate = true
[alias]
	# Structural (AST-aware) diff on demand: `git dft`
	dft = -c diff.external=difft diff
[credential "https://github.com"]
	helper = !PATH=\"/opt/homebrew/bin:$PATH\" gh auth git-credential
[credential "https://gist.github.com"]
	helper = !PATH=\"/opt/homebrew/bin:$PATH\" gh auth git-credential
# Git LFS. Without the smudge filter a checkout yields pointer files rather
# than content, which silently changes archive checksums — Go module zip
# hashes, for one, so go.sum verification fails with what looks like a
# supply-chain alert. required = true so a missing git-lfs fails loudly
# instead of checking out pointers, the same rule the pre-commit hook follows.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Machine-local overrides, last so they win. Untracked and optional: git
# silently ignores a missing include. Use it for anything that differs per
# box — signing key/format, proxies, work identities.
[include]
	path = ~/.config/git/config.local
